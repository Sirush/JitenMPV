<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Matches JitenMPV.App: a RID-specific publish must not leave this project's symbols beside
         the single-file executable. Plain builds keep theirs. -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\scripts\jiten-mpv.lua" Link="Resources\jiten-mpv.lua" LogicalName="JitenMPV.Core.Resources.jiten-mpv.lua"/>
    </ItemGroup>

</Project>
