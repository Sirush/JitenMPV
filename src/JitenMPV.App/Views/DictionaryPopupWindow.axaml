<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JitenMPV.App.ViewModels"
        xmlns:controls="using:JitenMPV.App.Controls"
        xmlns:interaction="using:JitenMPV.Core.Interaction"
        x:Class="JitenMPV.App.Views.DictionaryPopupWindow"
        x:DataType="vm:PopupViewModel"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        MaxWidth="550"
        ShowActivated="False">

    <Window.Styles>
        <Style Selector="Button.state-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Button.state-neverforget">
            <Setter Property="Foreground" Value="#55DD55"/>
            <Setter Property="BorderBrush" Value="#55DD55"/>
        </Style>
        <Style Selector="Button.state-neverforget:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A55DD55"/>
        </Style>
        <Style Selector="Button.state-blacklist">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#999999"/>
        </Style>
        <Style Selector="Button.state-blacklist:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1ACCCCCC"/>
        </Style>
        <Style Selector="Button.state-suspend">
            <Setter Property="Foreground" Value="#DDAA44"/>
            <Setter Property="BorderBrush" Value="#DDAA44"/>
        </Style>
        <Style Selector="Button.state-suspend:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1ADDAA44"/>
        </Style>
        <Style Selector="Button.state-forget">
            <Setter Property="Foreground" Value="#DD4444"/>
            <Setter Property="BorderBrush" Value="#DD4444"/>
        </Style>
        <Style Selector="Button.state-forget:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1ADD4444"/>
        </Style>

        <Style Selector="Button.state-mine">
            <Setter Property="Foreground" Value="#44BBDD"/>
            <Setter Property="BorderBrush" Value="#44BBDD"/>
        </Style>
        <Style Selector="Button.state-mine:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A44BBDD"/>
        </Style>
        <Style Selector="Button.state-mine.mined">
            <Setter Property="Foreground" Value="#66BB66"/>
            <Setter Property="BorderBrush" Value="#66BB66"/>
        </Style>
        <Style Selector="Button.state-rotate">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderBrush" Value="#666666"/>
        </Style>
        <Style Selector="Button.state-rotate:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AAAAAAA"/>
        </Style>

        <Style Selector="Button.headword">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.headword /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.headword:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.headword.linkable">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.headword.linkable:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="#D8B9FA"/>
        </Style>
        <Style Selector="Button.deck-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style Selector="Button.deck-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>

        <Style Selector="Button.review-btn">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Button.review-again">
            <Setter Property="Background" Value="#442222"/>
            <Setter Property="Foreground" Value="#FF6666"/>
            <Setter Property="BorderBrush" Value="#883333"/>
        </Style>
        <Style Selector="Button.review-again:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#553333"/>
        </Style>
        <Style Selector="Button.review-hard">
            <Setter Property="Background" Value="#443322"/>
            <Setter Property="Foreground" Value="#DDAA55"/>
            <Setter Property="BorderBrush" Value="#886633"/>
        </Style>
        <Style Selector="Button.review-hard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#554433"/>
        </Style>
        <Style Selector="Button.review-good">
            <Setter Property="Background" Value="#224422"/>
            <Setter Property="Foreground" Value="#66DD66"/>
            <Setter Property="BorderBrush" Value="#338833"/>
        </Style>
        <Style Selector="Button.review-good:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#335533"/>
        </Style>
        <Style Selector="Button.review-easy">
            <Setter Property="Background" Value="#222244"/>
            <Setter Property="Foreground" Value="#6688FF"/>
            <Setter Property="BorderBrush" Value="#334488"/>
        </Style>
        <Style Selector="Button.review-easy:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#333355"/>
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- Instantiated both above and below the entry; only the one the setting selects is visible. -->
        <DataTemplate x:Key="ActionsTemplate" DataType="vm:PopupViewModel">
            <StackPanel Spacing="6">
                <WrapPanel IsVisible="{Binding ShowActionRow}">
                    <Button Classes="state-btn state-neverforget"
                            Content="{Binding MasterLabel}"
                            Command="{Binding NeverForgetCommand}"
                            IsVisible="{Binding ShowNeverForget}"
                            Margin="0,0,6,4"/>
                    <Button Classes="state-btn state-blacklist"
                            Content="{Binding BlacklistLabel}"
                            Command="{Binding BlacklistCommand}"
                            IsVisible="{Binding ShowBlacklist}"
                            Margin="0,0,6,4"/>
                    <Button Classes="state-btn state-suspend"
                            Content="{Binding SuspendLabel}"
                            Command="{Binding SuspendCommand}"
                            IsVisible="{Binding ShowSuspend}"
                            Margin="0,0,6,4"/>
                    <Button Classes="state-btn state-forget"
                            Content="Forget"
                            Command="{Binding ForgetCommand}"
                            IsVisible="{Binding ShowForget}"
                            Margin="0,0,6,4"/>
                    <Button Classes="state-btn state-mine"
                            Classes.mined="{Binding IsMined}"
                            Content="{Binding MineLabel}"
                            Command="{Binding MineCommand}"
                            IsVisible="{Binding ShowMine}"
                            Margin="0,0,6,4"/>
                </WrapPanel>
                <Border IsVisible="{Binding IsDeckPickerOpen}"
                        Background="#22FFFFFF" CornerRadius="6" Padding="2" Margin="0,0,0,4">
                    <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DeckOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DeckOptionItem">
                                    <Button Classes="deck-item"
                                            Content="{Binding Name}"
                                            Command="{Binding Pick}"
                                            CommandParameter="{Binding Option}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding ShowRotate}">
                    <Button Classes="state-btn state-rotate"
                            Content="{Binding RotateBackwardLabel}"
                            Command="{Binding RotateBackwardCommand}"
                            IsVisible="{Binding ShowRotateBackward}"/>
                    <Button Classes="state-btn state-rotate"
                            Content="{Binding RotateForwardLabel}"
                            Command="{Binding RotateForwardCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding ShowReview}">
                    <Button Classes="review-btn review-again" Content="again" Command="{Binding ReviewAgainCommand}"/>
                    <Button Classes="review-btn review-hard" Content="hard" Command="{Binding ReviewHardCommand}"
                            IsVisible="{Binding ShowHardEasy}"/>
                    <Button Classes="review-btn review-good" Content="good" Command="{Binding ReviewGoodCommand}"/>
                    <Button Classes="review-btn review-easy" Content="easy" Command="{Binding ReviewEasyCommand}"
                            IsVisible="{Binding ShowHardEasy}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <LayoutTransformControl x:Name="ScaleContainer">
    <Border Background="{Binding PopupBackground}"
            CornerRadius="8"
            Padding="14"
            BorderBrush="#444444"
            BorderThickness="1">
        <StackPanel Spacing="6" MinWidth="220">
            <ContentControl Content="{Binding}"
                            ContentTemplate="{StaticResource ActionsTemplate}"
                            IsVisible="{Binding !MoveActionsBottom}"/>
            <TextBlock Text="{Binding Reading}"
                       FontSize="14" Foreground="#AAAAAA"
                       IsVisible="{Binding ShowReading}"
                       Margin="0,2,0,-4"/>
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0"
                        Classes="headword"
                        Classes.linkable="{Binding HeadwordLinkEnabled}"
                        Command="{Binding OpenHeadwordCommand}"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Panel>
                        <TextBlock Text="{Binding Spelling}" IsVisible="{Binding !ShowFurigana}"/>
                        <ItemsControl ItemsSource="{Binding FuriganaSegments}"
                                      IsVisible="{Binding ShowFurigana}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:FuriganaItem">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Ruby}"
                                                   FontSize="13" Foreground="#AAAAAA"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,-3"/>
                                        <TextBlock Text="{Binding Text}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Top"
                            HorizontalAlignment="Right" Spacing="2">
                    <ItemsControl ItemsSource="{Binding StateBadges}" HorizontalAlignment="Right">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Right"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:StateBadgeItem">
                                <Border CornerRadius="3" Padding="5,1" Margin="4,0,0,2"
                                        BorderThickness="1"
                                        BorderBrush="{Binding Foreground}">
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="11"
                                               Foreground="{Binding Foreground}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="13" Foreground="#666666"
                               IsVisible="{Binding ShowFrequency}"
                               HorizontalAlignment="Right">
                        <Run Text="#"/><Run Text="{Binding FrequencyRank}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <TextBlock FontSize="13" Foreground="#AAAAAA"
                       IsVisible="{Binding ShowPitch}">
                <Run Text="Pitch: "/><Run Text="{Binding PitchAccents}"/>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding PitchDiagrams}"
                          IsVisible="{Binding ShowPitchDiagrams}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="interaction:PitchDiagramRow">
                        <controls:PitchDiagramControl Row="{Binding}" Margin="0,0,10,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding DeckMembership}"
                          IsVisible="{Binding ShowDeckMembership}"
                          Opacity="0.85" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DeckMembershipItem">
                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,2">
                            <Ellipse Grid.Column="0" Width="7" Height="7"
                                     Fill="{Binding Dot}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Label}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#BBBBBB"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Names}"
                                       IsVisible="{Binding HasNames}"
                                       FontSize="12" Foreground="#999999"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border IsVisible="{Binding ShowConjugation}"
                    BorderBrush="#444444" BorderThickness="1"
                    CornerRadius="4" Padding="8,5">
                <TextBlock FontSize="13" Foreground="#AAAAAA">
                    <Run Text="Conjugation: " FontWeight="SemiBold"/><Run Text="{Binding Conjugation}"/>
                </TextBlock>
            </Border>
            <TextBlock Text="{Binding PartsOfSpeech}"
                       FontSize="13" Foreground="#7799CC"
                       IsVisible="{Binding ShowPartsOfSpeech}"
                       TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding Meanings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="14" Foreground="#DDDDDD"
                                   TextWrapping="Wrap"
                                   Margin="0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ContentControl Content="{Binding}"
                            ContentTemplate="{StaticResource ActionsTemplate}"
                            IsVisible="{Binding MoveActionsBottom}"
                            Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
    </LayoutTransformControl>
</Window>
