<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JitenMPV.App.ViewModels"
        xmlns:converters="using:JitenMPV.App.Converters"
        x:Class="JitenMPV.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="JitenMPV Settings"
        Width="750" Height="580"
        MinWidth="650" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        RequestedThemeVariant="Dark">

  <Window.Resources>
    <converters:ParseEqualsConverter x:Key="ParseEquals" />
    <converters:HexColorConverter x:Key="HexToColor" />
    <converters:StringToBrushConverter x:Key="StringToBrush" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Foreground" Value="#a1a1aa" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Foreground" Value="#ffffff" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Foreground" Value="#ffffff" />
    </Style>

    <Style Selector="TextBlock.section-header">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#71717a" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="#27272a" />
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>

    <!-- Label/field pairs in a two-column grid. The fixed field width keeps the spinner buttons
         from squeezing the text box until the value is clipped. -->
    <Style Selector="TextBlock.field-label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#a1a1aa" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="NumericUpDown.field">
      <Setter Property="Width" Value="160" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#c084fc" />
      <Setter Property="Foreground" Value="#18181b" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#d8b4fe" />
      <Setter Property="Foreground" Value="#18181b" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#a855f7" />
      <Setter Property="Foreground" Value="#ffffff" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#27272a" />
      <Setter Property="Foreground" Value="#d4d4d8" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3f3f46" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto">

    <Grid ColumnDefinitions="180,*">

      <Border Grid.Column="0" Background="#09090b" BorderBrush="#27272a" BorderThickness="0,0,1,0">
        <ListBox SelectedIndex="{Binding SelectedTabIndex}"
                 Background="Transparent"
                 Padding="0,8">
          <ListBoxItem Content="General" />
          <ListBoxItem Content="Appearance" />
          <ListBoxItem Content="Features" />
          <ListBoxItem Content="Media" />
          <ListBoxItem Content="Popup" />
          <ListBoxItem Content="Keybinds" />
          <ListBoxItem Content="Advanced" />
        </ListBox>
      </Border>

      <!-- Inset lives on the content, not on the ScrollViewer: ScrollViewer.Padding shrinks the
           viewport without growing the extent, leaving the last 32px permanently unreachable. -->
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

        <Border Grid.Row="0" IsVisible="{Binding IsUpdateBannerVisible}"
                Background="#1c1917" BorderBrush="#60a5fa" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="24,16,24,0">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding UpdateBannerText}" FontSize="12" Foreground="#fafafa"
                         TextWrapping="Wrap"
                         IsVisible="{Binding UpdateBannerText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding UpdateStatus}" FontSize="12"
                         Foreground="{Binding UpdateStatusColor, Converter={StaticResource StringToBrush}}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <StackPanel Spacing="2" IsVisible="{Binding IsUpdating}">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdatePercent}" Height="4" />
                <TextBlock Text="{Binding UpdateStage}" FontSize="11" Foreground="#a1a1aa" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="Release notes" Classes="secondary" VerticalAlignment="Center"
                    IsVisible="{Binding CanInstallUpdate}"
                    Command="{Binding OpenReleaseNotesCommand}" />
            <Button Grid.Column="2" Content="Install update" Classes="accent" VerticalAlignment="Center"
                    IsVisible="{Binding CanInstallUpdate}"
                    Command="{Binding InstallUpdateCommand}" />
          </Grid>
        </Border>

        <Border Grid.Row="1" IsVisible="{Binding IsInstallBannerVisible}"
                Background="#1c1917" BorderBrush="#c084fc" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="24,16,24,0">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding InstallBannerText}" FontSize="12" Foreground="#fafafa"
                         TextWrapping="Wrap" IsVisible="{Binding ShowInstallBanner}" />
              <TextBlock Text="{Binding InstallStatus}" FontSize="12"
                         Foreground="{Binding InstallStatusColor, Converter={StaticResource StringToBrush}}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding InstallStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Install" Classes="accent" VerticalAlignment="Center"
                    IsVisible="{Binding ShowInstallBanner}"
                    Command="{Binding InstallForMpvCommand}" />
          </Grid>
        </Border>

      <ScrollViewer Grid.Row="2" x:Name="ContentScroll">
        <Panel Margin="24,16">


          <!-- ═══════ GENERAL TAB ═══════ -->
          <StackPanel IsVisible="{Binding SelectedTabIndex, Converter={StaticResource ParseEquals}, ConverterParameter=0}"
                      Spacing="16">
            <TextBlock Text="General" FontSize="20" FontWeight="Bold" Foreground="#ffffff" />

            <StackPanel Spacing="4">
              <TextBlock Text="API Key" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                <TextBox Text="{Binding ApiKey}"
                         RevealPassword="{Binding IsApiKeyVisible}"
                         PasswordChar="*"
                         PlaceholderText="Enter your jiten.moe API key" />
                <Button Grid.Column="1" Content="Show"
                        Classes="secondary"
                        Command="{Binding ToggleApiKeyVisibilityCommand}" />
                <Button Grid.Column="2" Content="Test"
                        Classes="secondary"
                        Command="{Binding TestApiKeyCommand}"
                        IsEnabled="{Binding !IsTestingApiKey}" />
              </Grid>
              <TextBlock Text="{Binding ApiKeyStatus}" FontSize="12"
                         Foreground="{Binding ApiKeyStatusColor, Converter={StaticResource StringToBrush}}"
                         IsVisible="{Binding ApiKeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="Get your API key from jiten.moe/settings"
                         FontSize="11" Foreground="#71717a" />
            </StackPanel>

            <Border Classes="divider" />

            <Border Background="#0a0a0a" BorderBrush="#27272a" BorderThickness="1"
                    CornerRadius="6" Padding="14">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,Auto,*">
                  <TextBlock Text="ffmpeg" Foreground="#fafafa" FontSize="14" FontWeight="Medium"
                             VerticalAlignment="Center" />
                  <Border Grid.Column="1" Margin="8,0,0,0" Padding="6,2" CornerRadius="4"
                          Background="#3f1d2e" IsVisible="{Binding ShowFfmpegSetup}">
                    <TextBlock Text="REQUIRED" FontSize="9" FontWeight="Bold" Foreground="#fca5a5" />
                  </Border>
                </Grid>

                <TextBlock Text="{Binding FfmpegStatus}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{Binding FfmpegStatusColor, Converter={StaticResource StringToBrush}}"
                           IsVisible="{Binding FfmpegStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <TextBlock Text="Mining audio and clips, and burning subtitles into screenshots, all run through ffmpeg. Subtitle colouring and plain screenshots work without it."
                           FontSize="11" Foreground="#71717a" TextWrapping="Wrap"
                           IsVisible="{Binding ShowFfmpegSetup}" />

                <Button Content="{Binding FfmpegDownloadLabel}"
                        Classes="accent"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Height="38" FontSize="14"
                        Command="{Binding InstallFfmpegCommand}"
                        IsVisible="{Binding CanDownloadFfmpeg}" />

                <StackPanel Spacing="4" IsVisible="{Binding IsInstallingFfmpeg}">
                  <ProgressBar Value="{Binding FfmpegInstallPercent}" Minimum="0" Maximum="100" Height="6" />
                  <TextBlock Text="{Binding FfmpegInstallStage}" FontSize="11" Foreground="#a1a1aa" />
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding ShowFfmpegManual}">
                  <TextBlock Text="{Binding FfmpegManualHint}" FontSize="11" Foreground="#71717a" />
                  <TextBox Text="{Binding FfmpegManualCommand, Mode=OneWay}"
                           IsReadOnly="True" FontFamily="Consolas,monospace" FontSize="12"
                           Background="#18181b" BorderThickness="0" Padding="8,6" />
                </StackPanel>

                <TextBlock IsVisible="{Binding ShowFfmpegAttribution}"
                           FontSize="10" Foreground="#52525b" TextWrapping="Wrap"
                           Text="ffmpeg is a separate program licensed under the LGPL, downloaded from BtbN/FFmpeg-Builds. See ffmpeg.org/legal.html and the SOURCE.txt beside the installed copy." />

                <Expander Header="Use a specific ffmpeg" Padding="0" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="6" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Text="{Binding FfmpegPath}"
                               PlaceholderText="Leave blank to find it automatically" />
                      <Button Grid.Column="1" Content="Check" Classes="secondary"
                              Command="{Binding DetectFfmpegCommand}" />
                    </Grid>
                    <TextBlock Text="Point this at an ffmpeg executable if you keep one somewhere unusual."
                               FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />
                    <CheckBox Content="Stop reminding me in mpv"
                              IsChecked="{Binding FfmpegPromptDismissed}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Text="UPDATES" Classes="section-header" />
              <CheckBox Content="Check for new versions" IsChecked="{Binding UpdateCheckEnabled}" />
              <TextBlock Text="Check daily for new releases. Nothing is downloaded until you press Install update."
                         FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Check now" Classes="secondary"
                        Command="{Binding CheckForUpdatesNowCommand}"
                        IsEnabled="{Binding CanCheckForUpdates}" />
                <TextBlock Text="{Binding UpdateCheckStatus}" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{Binding UpdateCheckStatusColor, Converter={StaticResource StringToBrush}}"
                           IsVisible="{Binding UpdateCheckStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </StackPanel>

            <Border Classes="divider" />

            <Expander Header="Advanced API Settings">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <StackPanel Spacing="4">
                  <TextBlock Text="API Base URL" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                  <TextBox Text="{Binding ApiBaseUrl}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="API Timeout (seconds)" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                  <NumericUpDown Value="{Binding ApiTimeoutSeconds}"
                                 Minimum="5" Maximum="300" Increment="5" />
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>

          <!-- ═══════ APPEARANCE TAB ═══════ -->
          <StackPanel IsVisible="{Binding SelectedTabIndex, Converter={StaticResource ParseEquals}, ConverterParameter=1}"
                      Spacing="16">
            <TextBlock Text="Appearance" FontSize="20" FontWeight="Bold" Foreground="#ffffff" />

            <StackPanel Spacing="4">
              <TextBlock Text="Theme" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
              <ComboBox ItemsSource="{Binding AvailableThemes}"
                        SelectedItem="{Binding SelectedTheme}" MinWidth="200" />
            </StackPanel>

            <Expander Header="Import from JitenReader" Padding="0">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="Paste a JitenReader theme share code (jtr:1...)"
                           FontSize="12" Foreground="#71717a" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding ImportCode}" PlaceholderText="jtr:1..." />
                  <Button Grid.Column="1" Content="Import" Classes="accent"
                          Command="{Binding ImportThemeCodeCommand}" />
                </Grid>
                <TextBlock Text="{Binding ImportStatus}" FontSize="12" Foreground="#a1a1aa"
                           IsVisible="{Binding ImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Expander>

            <!-- Custom Theme Editor -->
            <StackPanel IsVisible="{Binding IsCustomTheme}" Spacing="8">
              <TextBlock Text="WORD STATE STYLES" Classes="section-header" />
              <TextBlock Text="Customize the appearance for each word knowledge state"
                         FontSize="12" Foreground="#71717a" />

              <ItemsControl ItemsSource="{Binding CustomStateStyles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StateStyleViewModel">
                    <Expander Margin="0,2">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Border Width="14" Height="14" CornerRadius="3"
                                  Background="{Binding SwatchColor, Converter={StaticResource StringToBrush}}" />
                          <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Medium"
                                     Foreground="#d4d4d8" VerticalAlignment="Center" />
                        </StackPanel>
                      </Expander.Header>

                      <Border Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1"
                              CornerRadius="8" Padding="16" Margin="0,4,0,0">
                        <StackPanel Spacing="12">

                          <!-- Colors -->
                          <StackPanel Spacing="8">
                            <TextBlock Text="COLORS" Classes="section-header" />
                            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                              <TextBlock Text="Text" VerticalAlignment="Center" Foreground="#a1a1aa" />
                              <ColorPicker Grid.Column="1" IsAlphaVisible="False"
                                           Color="{Binding TextColor, Converter={StaticResource HexToColor}}"
                                           HorizontalAlignment="Left" />

                              <TextBlock Grid.Row="1" Text="Outline" VerticalAlignment="Center" Foreground="#a1a1aa" />
                              <ColorPicker Grid.Row="1" Grid.Column="1" IsAlphaVisible="False"
                                           Color="{Binding OutlineColor, Converter={StaticResource HexToColor}}"
                                           HorizontalAlignment="Left" />

                              <TextBlock Grid.Row="2" Text="Shadow" VerticalAlignment="Center" Foreground="#a1a1aa" />
                              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <CheckBox IsChecked="{Binding HasShadow}" VerticalAlignment="Center" />
                                <ColorPicker Color="{Binding ShadowColor, Converter={StaticResource HexToColor}}"
                                             IsAlphaVisible="False"
                                             IsEnabled="{Binding HasShadow}" HorizontalAlignment="Left" />
                              </StackPanel>
                            </Grid>
                          </StackPanel>

                          <!-- Sizes -->
                          <StackPanel Spacing="8">
                            <TextBlock Text="SIZES" Classes="section-header" />
                            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                              <TextBlock Text="Outline" VerticalAlignment="Center" Foreground="#a1a1aa" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Slider Value="{Binding OutlineSize}" Minimum="0" Maximum="10" Width="200"
                                        TickFrequency="0.5" IsSnapToTickEnabled="True" />
                                <TextBlock Text="{Binding OutlineSize, StringFormat='{}{0:F1}'}"
                                           VerticalAlignment="Center" Width="30" Foreground="#ffffff" />
                              </StackPanel>

                              <TextBlock Grid.Row="1" Text="Shadow" VerticalAlignment="Center" Foreground="#a1a1aa" />
                              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Slider Value="{Binding ShadowDepth}" Minimum="0" Maximum="10" Width="200"
                                        IsEnabled="{Binding HasShadow}"
                                        TickFrequency="0.5" IsSnapToTickEnabled="True" />
                                <TextBlock Text="{Binding ShadowDepth, StringFormat='{}{0:F1}'}"
                                           VerticalAlignment="Center" Width="30" Foreground="#ffffff" />
                              </StackPanel>
                            </Grid>
                          </StackPanel>

                          <!-- Opacity -->
                          <StackPanel Spacing="8">
                            <TextBlock Text="OPACITY" Classes="section-header" />
                            <Grid ColumnDefinitions="90,*">
                              <TextBlock Text="Text" VerticalAlignment="Center" Foreground="#a1a1aa" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Slider Value="{Binding TextOpacityPercent}" Minimum="0" Maximum="100" Width="200" />
                                <TextBlock Text="{Binding TextOpacityPercent, StringFormat='{}{0}%'}"
                                           VerticalAlignment="Center" Width="40" Foreground="#ffffff" />
                              </StackPanel>
                            </Grid>
                          </StackPanel>

                          <!-- Text Effects -->
                          <StackPanel Spacing="8">
                            <TextBlock Text="TEXT EFFECTS" Classes="section-header" />
                            <WrapPanel Orientation="Horizontal">
                              <CheckBox Content="Bold" IsChecked="{Binding Bold}" Margin="0,0,16,4" />
                              <CheckBox Content="Italic" IsChecked="{Binding Italic}" Margin="0,0,16,4" />
                              <CheckBox Content="Underline" IsChecked="{Binding Underline}" Margin="0,0,16,4" />
                              <CheckBox Content="Strikethrough" IsChecked="{Binding Strikethrough}" />
                            </WrapPanel>
                          </StackPanel>

                        </StackPanel>
                      </Border>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Text="PITCH ACCENT COLOURS" Classes="section-header" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleSwitch IsChecked="{Binding PitchColoringEnabled}" />
                <TextBlock Text="Colour words by pitch pattern" FontSize="14"
                           VerticalAlignment="Center" Foreground="#ffffff" />
              </StackPanel>
              <TextBlock Text="Replaces the word's knowledge-state colour. Outlines, i+1 and frequency marks are kept."
                         FontSize="12" Foreground="#71717a" TextWrapping="Wrap" />

              <StackPanel IsVisible="{Binding PitchColoringEnabled}" Spacing="6" Margin="0,4,0,0">
                <TextBlock Text="Show the pitch as" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <RadioButton GroupName="PitchIndicator" Content="Text colour"
                               IsChecked="{Binding PitchIndicator, Converter={StaticResource ParseEquals}, ConverterParameter=Text}" />
                  <RadioButton GroupName="PitchIndicator" Content="Underline"
                               IsChecked="{Binding PitchIndicator, Converter={StaticResource ParseEquals}, ConverterParameter=Underline}" />
                </StackPanel>
                <TextBlock FontSize="12" Foreground="#71717a" TextWrapping="Wrap"
                           Text="Text colour replaces the word's colour. Underline keeps it and draws a coloured bar underneath."
                           Margin="0,0,0,4" />
                <StackPanel IsVisible="{Binding IsPitchUnderline}" Spacing="4" Margin="0,0,0,4">
                  <TextBlock Text="Underline thickness" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Slider Value="{Binding PitchUnderlineThickness}" Minimum="1" Maximum="16" Width="250" />
                    <TextBlock Text="{Binding PitchUnderlineThickness, StringFormat='{}{0:F0}px'}"
                               VerticalAlignment="Center" Width="50" Foreground="#ffffff" />
                  </StackPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding PitchStyles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PitchStyleViewModel">
                      <Grid ColumnDefinitions="110,Auto" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                   Foreground="#a1a1aa" FontSize="13" />
                        <ColorPicker Grid.Column="1" IsAlphaVisible="False"
                                     HorizontalAlignment="Left"
                                     Color="{Binding Color, Converter={StaticResource HexToColor}}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Reset to default colours" Command="{Binding ResetPitchColorsCommand}"
                        HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Text="FONT" Classes="section-header" />
              <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="Family" VerticalAlignment="Center" Foreground="#a1a1aa" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFonts}"
                          Text="{Binding FontFamily}" IsEditable="True"
                          HorizontalAlignment="Left" Width="300" MaxDropDownHeight="320" />

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding FontWarning}" FontSize="11" Foreground="#fbbf24"
                             TextWrapping="Wrap" IsVisible="{Binding HasFontWarning}" />
                  <TextBlock Text="世界、こんにちは。" FontSize="20" Foreground="#fafafa"
                             FontFamily="{Binding PreviewFont}" />
                  <TextBlock Text="Preview of the installed font. Check the kanji look Japanese and not Chinese."
                             FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Size" VerticalAlignment="Center" Foreground="#a1a1aa" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Slider Value="{Binding FontSize}" Minimum="24" Maximum="96" Width="300"
                          TickFrequency="1" IsSnapToTickEnabled="True" />
                  <TextBlock Text="{Binding FontSize}" VerticalAlignment="Center"
                             Width="30" Foreground="#ffffff" />
                </StackPanel>

                <TextBlock Grid.Row="3" Text="Border" VerticalAlignment="Center" Foreground="#a1a1aa" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Slider Value="{Binding BorderSize}" Minimum="0" Maximum="10" Width="300"
                          TickFrequency="0.5" IsSnapToTickEnabled="True" />
                  <TextBlock Text="{Binding BorderSize, StringFormat='{}{0:F1}'}"
                             VerticalAlignment="Center" Width="30" Foreground="#ffffff" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Text="SUBTITLE POSITION" Classes="section-header" />

              <TextBlock Text="Alignment" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
              <UniformGrid Rows="3" Columns="3" Width="150" Height="150">
                <ToggleButton Content="&#x2196;" Command="{Binding SetSubtitleAlignmentCommand}" CommandParameter="7" IsChecked="{Binding SubtitleAlignment, Mode=OneWay, Converter={StaticResource ParseEquals}, ConverterParameter=7}" />
                <ToggleButton Content="&#x2191;" Command="{Binding SetSubtitleAlignmentCommand}" CommandParameter="8" IsChecked="{Binding SubtitleAlignment, Mode=OneWay, Converter={StaticResource ParseEquals}, ConverterParameter=8}" />
                <ToggleButton Content="&#x2197;" Command="{Binding SetSubtitleAlignmentCommand}" CommandParameter="9" IsChecked="{Binding SubtitleAlignment, Mode=OneWay, Converter={StaticResource ParseEquals}, ConverterParameter=9}" />
                <ToggleButton Content="&#x2190;" Command="{Binding SetSubtitleAlignmentCommand}" CommandParameter="4" IsChecked="{Binding SubtitleAlignment, Mode=OneWay, Converter={StaticResource ParseEquals}, ConverterParameter=4}" />
                <ToggleButton Content="&#x2022;" Command="{Binding SetSubtitleAlignmentCommand}" CommandParameter="5" IsChecked="{Binding SubtitleAlignment, Mode=OneWay, Converter={StaticResource ParseEquals}, ConverterParameter=5}" />
                <ToggleButton Content="&#x2192;" Command="{Binding SetSubtitleAlignmentCommand}" CommandParameter="6" IsChecked="{Binding SubtitleAlignment, Mode=OneWay, Converter={StaticResource ParseEquals}, ConverterParameter=6}" />
                <ToggleButton Content="&#x2199;" Command="{Binding SetSubtitleAlignmentCommand}" CommandParameter="1" IsChecked="{Binding SubtitleAlignment, Mode=OneWay, Converter={StaticResource ParseEquals}, ConverterParameter=1}" />
                <ToggleButton Content="&#x2193;" Command="{Binding SetSubtitleAlignmentCommand}" CommandParameter="2" IsChecked="{Binding SubtitleAlignment, Mode=OneWay, Converter={StaticResource ParseEquals}, ConverterParameter=2}" />
                <ToggleButton Content="&#x2198;" Command="{Binding SetSubtitleAlignmentCommand}" CommandParameter="3" IsChecked="{Binding SubtitleAlignment, Mode=OneWay, Converter={StaticResource ParseEquals}, ConverterParameter=3}" />
              </UniformGrid>

              <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBlock Text="Margin X" VerticalAlignment="Center" Foreground="#a1a1aa" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Slider Value="{Binding SubtitleMarginX}" Minimum="0" Maximum="400" Width="300" />
                  <TextBlock Text="{Binding SubtitleMarginX, StringFormat='{}{0}px'}"
                             VerticalAlignment="Center" Width="50" Foreground="#ffffff" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Margin Y" VerticalAlignment="Center" Foreground="#a1a1aa" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Slider Value="{Binding SubtitleMarginY}" Minimum="0" Maximum="400" Width="300" />
                  <TextBlock Text="{Binding SubtitleMarginY, StringFormat='{}{0}px'}"
                             VerticalAlignment="Center" Width="50" Foreground="#ffffff" />
                </StackPanel>
              </Grid>

              <CheckBox Content="Join wrapped lines into one line when it fits"
                        IsChecked="{Binding SubtitleSingleLine}" />
              <TextBlock Text="Removes the line breaks the subtitle file put in. Lines too long to fit the screen keep their own breaks."
                         FontSize="12" Foreground="#71717a" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>

          <!-- ═══════ FEATURES TAB ═══════ -->
          <StackPanel IsVisible="{Binding SelectedTabIndex, Converter={StaticResource ParseEquals}, ConverterParameter=2}"
                      Spacing="16">
            <TextBlock Text="Features" FontSize="20" FontWeight="Bold" Foreground="#ffffff" />

            <Border Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1"
                    CornerRadius="8" Padding="16">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ToggleSwitch IsChecked="{Binding IPlusOneEnabled}" />
                  <TextBlock Text="i+1 Detection" FontSize="15" FontWeight="Medium"
                             VerticalAlignment="Center" Foreground="#ffffff" />
                </StackPanel>
                <TextBlock Text="Highlights sentences where you know all words except one"
                           FontSize="12" Foreground="#71717a" Margin="0,0,0,4" />
                <StackPanel IsVisible="{Binding IPlusOneEnabled}" Spacing="8" Margin="16,0,0,0">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Min words" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                    <NumericUpDown Value="{Binding IPlusOneMinTokens}"
                                   Minimum="2" Maximum="10" Increment="1" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Below frequency rank" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                    <NumericUpDown Value="{Binding IPlusOneMaxFrequencyRank}"
                                   Minimum="1000" Maximum="50000" Increment="1000" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1"
                    CornerRadius="8" Padding="16">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ToggleSwitch IsChecked="{Binding FrequencyMarkingEnabled}" />
                  <TextBlock Text="Frequency Marking" FontSize="15" FontWeight="Medium"
                             VerticalAlignment="Center" Foreground="#ffffff" />
                </StackPanel>
                <TextBlock Text="Underlines words within top N frequency"
                           FontSize="12" Foreground="#71717a" />
                <StackPanel IsVisible="{Binding FrequencyMarkingEnabled}" Spacing="8" Margin="16,0,0,0">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Below frequency rank" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                    <NumericUpDown Value="{Binding FrequencyTopN}"
                                   Minimum="1000" Maximum="50000" Increment="1000" />
                  </StackPanel>
                  <CheckBox Content="Mark all states (not just New)" IsChecked="{Binding FrequencyMarkAllStates}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1"
                    CornerRadius="8" Padding="16">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ToggleSwitch IsChecked="{Binding BlurEnabled}" />
                  <TextBlock Text="Blur / Spoiler Mode" FontSize="15" FontWeight="Medium"
                             VerticalAlignment="Center" Foreground="#ffffff" />
                </StackPanel>
                <TextBlock Text="Blurs words in selected states until hovered"
                           FontSize="12" Foreground="#71717a" />
                <StackPanel IsVisible="{Binding BlurEnabled}" Spacing="8" Margin="16,0,0,0">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Blur strength" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                    <Slider Value="{Binding BlurStrength}" Minimum="1" Maximum="20" Width="250" />
                  </StackPanel>
                  <CheckBox Content="Reveal on hover" IsChecked="{Binding BlurRevealOnHover}" />
                  <StackPanel IsVisible="{Binding BlurRevealOnHover}" Spacing="4">
                    <TextBlock Text="Reveal delay (ms)" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                    <NumericUpDown Value="{Binding BlurRevealDelayMs}"
                                   Minimum="0" Maximum="1000" Increment="50" />
                  </StackPanel>
                  <TextBlock Text="Blur these states:" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                  <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="New" IsChecked="{Binding BlurNew}" Margin="0,0,8,4" />
                    <CheckBox Content="Young" IsChecked="{Binding BlurYoung}" Margin="0,0,8,4" />
                    <CheckBox Content="Mature" IsChecked="{Binding BlurMature}" Margin="0,0,8,4" />
                    <CheckBox Content="Blacklisted" IsChecked="{Binding BlurBlacklisted}" Margin="0,0,8,4" />
                    <CheckBox Content="Due" IsChecked="{Binding BlurDue}" Margin="0,0,8,4" />
                    <CheckBox Content="Mastered" IsChecked="{Binding BlurMastered}" Margin="0,0,8,4" />
                    <CheckBox Content="Redundant" IsChecked="{Binding BlurRedundant}" />
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1"
                    CornerRadius="8" Padding="16">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ToggleSwitch IsChecked="{Binding AutopauseEnabled}" />
                  <TextBlock Text="Autopause" FontSize="15" FontWeight="Medium"
                             VerticalAlignment="Center" Foreground="#ffffff" />
                </StackPanel>
                <TextBlock Text="Pauses playback when hovering over subtitles"
                           FontSize="12" Foreground="#71717a" />
                <StackPanel IsVisible="{Binding AutopauseEnabled}" Spacing="8" Margin="16,0,0,0">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Pause delay (ms)" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                    <NumericUpDown Value="{Binding AutopauseDelayMs}"
                                   Minimum="0" Maximum="2000" Increment="100" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1"
                    CornerRadius="8" Padding="16">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ToggleSwitch IsChecked="{Binding MiningEnabled}" />
                  <TextBlock Text="Mining" FontSize="15" FontWeight="Medium"
                             VerticalAlignment="Center" Foreground="#ffffff" />
                </StackPanel>
                <StackPanel IsVisible="{Binding MiningEnabled}" Margin="16,0,0,0" Spacing="8">
                  <CheckBox Content="Attach the subtitle line as an example sentence"
                            IsChecked="{Binding MiningCaptureSentence}" />

                  <TextBlock Text="Target word list" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AvailableDecks}"
                              SelectedItem="{Binding SelectedStudyDeck}"
                              PlaceholderText="Load your lists to choose one">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Content="Load lists"
                            Command="{Binding LoadDecksCommand}"
                            IsEnabled="{Binding !IsLoadingDecks}" />
                  </Grid>
                  <TextBlock Text="{Binding DeckStatus}" Foreground="#a1a1aa" FontSize="12" />

                  <CheckBox Content="Mine straight to this list (otherwise the popup asks which list)"
                            IsChecked="{Binding MiningToStudyDeck}" />
                  <CheckBox Content="Also mine when grading a card"
                            IsChecked="{Binding MiningAutoOnReview}" />
                  <CheckBox Content="Skip words already in the target list"
                            IsChecked="{Binding MiningSkipIfPresent}" />

                  <TextBlock Text="Double-click a word" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding DoubleClickActions}"
                            SelectedItem="{Binding DoubleClickAction}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1"
                    CornerRadius="8" Padding="16">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ToggleSwitch IsChecked="{Binding ReviewsEnabled}" />
                  <TextBlock Text="Reviews" FontSize="15" FontWeight="Medium"
                             VerticalAlignment="Center" Foreground="#ffffff" />
                </StackPanel>
                <TextBlock Text="Grade cards from the popup. Turning this off hides the grade buttons and unbinds the review keys."
                           Foreground="#a1a1aa" FontSize="13" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ═══════ MEDIA TAB ═══════ -->
          <StackPanel IsVisible="{Binding SelectedTabIndex, Converter={StaticResource ParseEquals}, ConverterParameter=3}"
                      Spacing="16">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="Media" FontSize="20" FontWeight="Bold" Foreground="#ffffff"
                         VerticalAlignment="Center" />
              <Border Grid.Column="1" Background="#27272a" CornerRadius="6" Padding="10,4"
                      VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding JitenPlusTierLabel}"
                             FontSize="12" Foreground="#d4d4d8" />
                  <TextBlock Text="{Binding JitenPlusQuotaLabel}" FontSize="12" Foreground="#71717a"
                             IsVisible="{Binding JitenPlusQuotaLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Border>
              <Button Grid.Column="2" Content="Refresh" Classes="secondary"
                      Command="{Binding RefreshJitenPlusCommand}"
                      IsEnabled="{Binding !IsCheckingJitenPlus}" />
            </Grid>

            <TextBlock Text="{Binding JitenPlusStatus}" FontSize="12" Foreground="#a1a1aa"
                       IsVisible="{Binding JitenPlusStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Border Background="#2a1a1a" BorderBrush="#7f1d1d" BorderThickness="1" CornerRadius="8"
                    Padding="12" IsVisible="{Binding JitenPlusLocked}">
              <TextBlock Text="Jiten+ required. Adding screenshots and audio to your cards needs Jiten+. The free trial is enough."
                         Foreground="#fca5a5" FontSize="13" TextWrapping="Wrap" />
            </Border>

            <StackPanel Spacing="16" IsEnabled="{Binding !JitenPlusLocked}">
              <Border Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1"
                      CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleSwitch IsChecked="{Binding MediaCaptureEnabled}" />
                    <TextBlock Text="Add a screenshot and audio when mining" FontSize="15" FontWeight="Medium"
                               VerticalAlignment="Center" Foreground="#ffffff" />
                  </StackPanel>
                  <TextBlock Text="Saves a screenshot and the spoken line onto the card, will display during SRS study"
                             FontSize="12" Foreground="#71717a" TextWrapping="Wrap" />

                  <StackPanel IsVisible="{Binding MediaCaptureEnabled}" Margin="16,4,0,0" Spacing="10">

                    <CheckBox Content="Screenshot" IsChecked="{Binding MediaCaptureImage}" />
                    <StackPanel IsVisible="{Binding MediaCaptureImage}" Margin="24,0,0,0" Spacing="8">
                      <TextBlock Text="Screenshot capture position" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                      <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton GroupName="MediaImageSource" Content="Current position"
                                     IsChecked="{Binding MediaImageSource, Converter={StaticResource ParseEquals}, ConverterParameter=MpvFrame}" />
                        <RadioButton GroupName="MediaImageSource" Content="Middle of the subtitles"
                                     IsChecked="{Binding MediaImageSource, Converter={StaticResource ParseEquals}, ConverterParameter=SubtitleMidpoint}" />
                      </StackPanel>

                      <TextBlock Text="Subtitle display" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                      <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton GroupName="MediaSubtitleBurn" Content="None"
                                     IsChecked="{Binding MediaSubtitleBurn, Converter={StaticResource ParseEquals}, ConverterParameter=None}" />
                        <RadioButton GroupName="MediaSubtitleBurn" Content="No highlights"
                                     IsChecked="{Binding MediaSubtitleBurn, Converter={StaticResource ParseEquals}, ConverterParameter=Original}" />
                        <RadioButton GroupName="MediaSubtitleBurn" Content="With knowledge highlights"
                                     IsChecked="{Binding MediaSubtitleBurn, Converter={StaticResource ParseEquals}, ConverterParameter=Colored}" />
                      </StackPanel>
                      <TextBlock Text="{Binding SubtitleBurnHint}" FontSize="11" Foreground="#71717a"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SubtitleBurnWarning}" FontSize="11" Foreground="#fca5a5"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding SubtitleBurnWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                      <CheckBox Content="Use a short clip instead" IsChecked="{Binding MediaCaptureImageAnimated}" />
                      <TextBlock Text="A short looping video as long as the subtitle line. Uses more storage space."
                                 FontSize="11" Foreground="#71717a" TextWrapping="Wrap"
                                 Margin="24,0,0,0" />
                    </StackPanel>

                    <CheckBox Content="Audio" IsChecked="{Binding MediaCaptureAudio}" />
                    <StackPanel IsVisible="{Binding MediaCaptureAudio}" Margin="24,0,0,0" Spacing="8">
                      <CheckBox Content="Stereo" IsChecked="{Binding MediaAudioStereo}" />
                      <CheckBox Content="Trim the silence automatically" IsChecked="{Binding MediaAudioAutoTrim}" />
                    </StackPanel>

                    <CheckBox Content="Check everything before saving" IsChecked="{Binding MediaReviewPopup}" />
                    <Grid ColumnDefinitions="130,*" IsVisible="{Binding MediaReviewPopup}"
                          Margin="24,0,0,0">
                      <TextBlock Text="Nearby lines" Classes="field-label" />
                      <NumericUpDown Grid.Column="1" Classes="field"
                                     Value="{Binding MediaSentenceContextLines}"
                                     Minimum="0" Maximum="5" Increment="1" />
                    </Grid>
                    <TextBlock Text="How many lines before and after you can add to the sentence"
                               FontSize="11" Foreground="#71717a" TextWrapping="Wrap"
                               Margin="24,0,0,0" IsVisible="{Binding MediaReviewPopup}" />

                    <TextBlock Text="Warn before replacing the existing media from a card" Foreground="#a1a1aa"
                               FontSize="13" FontWeight="Medium" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                      <RadioButton GroupName="MediaOverwrite" Content="Always"
                                   IsChecked="{Binding MediaOverwritePrompt, Converter={StaticResource ParseEquals}, ConverterParameter=Always}" />
                      <RadioButton GroupName="MediaOverwrite" Content="Once per session"
                                   IsChecked="{Binding MediaOverwritePrompt, Converter={StaticResource ParseEquals}, ConverterParameter=OncePerSession}" />
                      <RadioButton GroupName="MediaOverwrite" Content="Never"
                                   IsChecked="{Binding MediaOverwritePrompt, Converter={StaticResource ParseEquals}, ConverterParameter=Never}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Expander Header="Advanced" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12" Margin="0,8,0,0">
                  <TextBlock Text="SCREENSHOT" Classes="section-header" />
                  <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <TextBlock Text="Longest side (px)" Classes="field-label" />
                    <NumericUpDown Grid.Column="1" Classes="field"
                                   Value="{Binding MediaImageMaxEdge}"
                                   Minimum="640" Maximum="2560" Increment="80" />
                    <TextBlock Grid.Row="1" Text="Quality" Classes="field-label" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="field"
                                   Value="{Binding MediaImageQuality}"
                                   Minimum="40" Maximum="100" Increment="1" />
                  </Grid>
                  <TextBlock Text="Screenshots are resized to 1600px (longest size) and Webp 82 quality by the Jiten API."
                             FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />

                  <Border Classes="divider" />

                  <TextBlock Text="CLIPS" Classes="section-header" />
                  <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Text="Framerate" Classes="field-label" />
                    <NumericUpDown Grid.Column="1" Classes="field"
                                   Value="{Binding MediaAnimTargetFps}"
                                   Minimum="5" Maximum="30" Increment="1" />
                    <TextBlock Grid.Row="1" Text="Width" Classes="field-label" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="field"
                                   Value="{Binding MediaAnimMaxEdge}"
                                   Minimum="320" Maximum="1600" Increment="80" />
                    <TextBlock Grid.Row="2" Text="Frame limit" Classes="field-label" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="field"
                                   Value="{Binding MediaAnimMaxFrames}"
                                   Minimum="30" Maximum="300" Increment="10" />
                    <TextBlock Grid.Row="3" Text="Quality" Classes="field-label" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Classes="field" Value="{Binding MediaAnimQuality}"
                                   Minimum="20" Maximum="100" Increment="5" />
                    <TextBlock Grid.Row="4" Text="Size limit (MB)" Classes="field-label" />
                    <NumericUpDown Grid.Row="4" Grid.Column="1" Classes="field"
                                   Value="{Binding MediaAnimMaxMb}"
                                   Minimum="0.5" Maximum="5" Increment="0.5" FormatString="0.0" />
                    <TextBlock Grid.Row="5" Text="Lowest smoothness" Classes="field-label" />
                    <NumericUpDown Grid.Row="5" Grid.Column="1" Classes="field"
                                   Value="{Binding MediaAnimMinFps}"
                                   Minimum="1" Maximum="30" Increment="1" />
                  </Grid>
                  <TextBlock Text="Automatically tries lower settings if the clip would be too big."
                             FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />

                  <Border Classes="divider" />

                  <TextBlock Text="AUDIO" Classes="section-header" />
                  <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Text="Bitrate (kbps)" Classes="field-label" />
                    <NumericUpDown Grid.Column="1" Classes="field"
                                   Value="{Binding MediaAudioBitrateKbps}"
                                   Minimum="24" Maximum="128" Increment="8" />
                    <TextBlock Grid.Row="1" Text="Extra at the start" Classes="field-label" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="field"
                                   Value="{Binding MediaAudioPadLeadMs}"
                                   Minimum="0" Maximum="2000" Increment="50" />
                    <TextBlock Grid.Row="2" Text="Extra at the end" Classes="field-label" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="field"
                                   Value="{Binding MediaAudioPadTailMs}"
                                   Minimum="0" Maximum="2000" Increment="50" />
                    <TextBlock Grid.Row="3" Text="Size limit (MB)" Classes="field-label" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Classes="field" Value="{Binding MediaAudioMaxMb}"
                                   Minimum="0.2" Maximum="5" Increment="0.5" FormatString="0.0" />
                    <TextBlock Grid.Row="4" Text="Room to trim (s)" Classes="field-label" />
                    <NumericUpDown Grid.Row="4" Grid.Column="1" Classes="field"
                                   Value="{Binding MediaAudioWindowMarginSeconds}"
                                   Minimum="1" Maximum="20" Increment="1" FormatString="0.0" />
                  </Grid>
                  <TextBlock Text="Milliseconds of extra audio kept on each side of the line, and how far past it you can drag when trimming by hand"
                             FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />

                  <Border Classes="divider" />

                  <TextBlock Text="FFMPEG" Classes="section-header" />
                  <TextBlock Text="{Binding FfmpegStatus}" FontSize="11" TextWrapping="Wrap"
                             Foreground="{Binding FfmpegStatusColor, Converter={StaticResource StringToBrush}}"
                             IsVisible="{Binding FfmpegStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="Set it up on the General tab."
                             FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </StackPanel>

          <!-- ═══════ POPUP TAB ═══════ -->
          <StackPanel IsVisible="{Binding SelectedTabIndex, Converter={StaticResource ParseEquals}, ConverterParameter=4}"
                      Spacing="16">
            <TextBlock Text="Popup" FontSize="20" FontWeight="Bold" Foreground="#ffffff" />

            <StackPanel Spacing="4">
              <TextBlock Text="Trigger" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
              <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton Content="Hover" GroupName="PopupTrigger"
                             IsChecked="{Binding PopupTrigger, Converter={StaticResource ParseEquals}, ConverterParameter=Hover}" />
                <RadioButton Content="Click" GroupName="PopupTrigger"
                             IsChecked="{Binding PopupTrigger, Converter={StaticResource ParseEquals}, ConverterParameter=Click}" />
              </StackPanel>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Text="TIMING" Classes="section-header" />
              <StackPanel Spacing="4">
                <TextBlock Text="Hover delay (ms)" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                <NumericUpDown Value="{Binding PopupHoverDelayMs}" Minimum="10" Maximum="3000" Increment="10" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Switch delay for a word on another line (ms)"
                           Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
                <NumericUpDown Value="{Binding PopupSwitchDelayMs}" Minimum="0" Maximum="2000" Increment="50" />
              </StackPanel>
              <CheckBox Content="Auto-hide popup" IsChecked="{Binding PopupAutoHide}" />
              <StackPanel IsVisible="{Binding PopupAutoHide}" Spacing="4" Margin="24,0,0,0">
                <TextBlock Text="Auto-hide delay (ms)" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                <NumericUpDown Value="{Binding PopupAutoHideDelayMs}" Minimum="100" Maximum="5000" Increment="100" />
              </StackPanel>
              <CheckBox Content="Hide popup after action" IsChecked="{Binding PopupHideAfterAction}" />
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Text="Position" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
              <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton Content="Above subtitle" GroupName="PopupPos"
                             IsChecked="{Binding PopupPosition, Converter={StaticResource ParseEquals}, ConverterParameter=AboveSubtitle}" />
                <RadioButton Content="Below subtitle" GroupName="PopupPos"
                             IsChecked="{Binding PopupPosition, Converter={StaticResource ParseEquals}, ConverterParameter=BelowSubtitle}" />
                <RadioButton Content="Fixed" GroupName="PopupPos"
                             IsChecked="{Binding PopupPosition, Converter={StaticResource ParseEquals}, ConverterParameter=Fixed}" />
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding IsFixedPopupPosition}">
                <TextBlock Text="Anchor" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding PopupAnchors}"
                          SelectedItem="{Binding PopupFixedAnchor}" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Gap from the word, or margin from the screen edge when fixed (px)"
                           Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
                <NumericUpDown Value="{Binding PopupOffsetPx}" Minimum="0" Maximum="600" Increment="10" />
              </StackPanel>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Text="APPEARANCE" Classes="section-header" />
              <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="Font scale" VerticalAlignment="Center" Foreground="#a1a1aa" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Slider Value="{Binding PopupFontScale}" Minimum="0.5" Maximum="1.5" Width="250"
                          TickFrequency="0.05" IsSnapToTickEnabled="True" />
                  <TextBlock Text="{Binding PopupFontScale, StringFormat='{}{0:F2}'}"
                             VerticalAlignment="Center" Foreground="#ffffff" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="BG opacity" VerticalAlignment="Center" Foreground="#a1a1aa" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Slider Value="{Binding PopupBgOpacity}" Minimum="0" Maximum="100" Width="250" />
                  <TextBlock Text="{Binding PopupBgOpacity, StringFormat='{}{0}%'}"
                             VerticalAlignment="Center" Foreground="#ffffff" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Background" VerticalAlignment="Center" Foreground="#a1a1aa" />
                <ColorPicker Grid.Row="2" Grid.Column="1" IsAlphaVisible="False"
                             Color="{Binding PopupBgColor, Converter={StaticResource HexToColor}}"
                             HorizontalAlignment="Left" />

                <TextBlock Grid.Row="3" Text="Max width" VerticalAlignment="Center" Foreground="#a1a1aa" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Slider Value="{Binding PopupMaxWidthPx}" Minimum="250" Maximum="1200" Width="250"
                          TickFrequency="10" IsSnapToTickEnabled="True" />
                  <TextBlock Text="{Binding PopupMaxWidthPx, StringFormat='{}{0} px'}"
                             VerticalAlignment="Center" Foreground="#ffffff" />
                </StackPanel>

                <TextBlock Grid.Row="4" Text="Max meanings" VerticalAlignment="Center" Foreground="#a1a1aa" />
                <NumericUpDown Grid.Row="4" Grid.Column="1"
                               Value="{Binding PopupMaxMeanings}" Minimum="1" Maximum="20" Increment="1" />
              </Grid>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Text="CONTENT" Classes="section-header" />
              <WrapPanel Orientation="Horizontal">
                <CheckBox Content="Furigana" IsChecked="{Binding PopupFurigana}" Margin="0,0,16,0" />
                <CheckBox Content="Pitch accent" IsChecked="{Binding PopupShowPitch}" Margin="0,0,16,0" />
                <CheckBox Content="Frequency rank" IsChecked="{Binding PopupShowFrequency}" Margin="0,0,16,0" />
                <CheckBox Content="Conjugation" IsChecked="{Binding PopupShowConjugation}" />
              </WrapPanel>
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Text="ACTION BUTTONS" Classes="section-header" />
              <CheckBox Content="Show state actions" IsChecked="{Binding PopupShowStateActions}" />
              <StackPanel IsVisible="{Binding PopupShowStateActions}" Margin="24,0,0,0" Spacing="4">
                <CheckBox Content="Never Forget" IsChecked="{Binding PopupShowNeverForget}" />
                <CheckBox Content="Blacklist" IsChecked="{Binding PopupShowBlacklist}" />
                <CheckBox Content="Suspend" IsChecked="{Binding PopupShowSuspend}" />
                <CheckBox Content="Forget" IsChecked="{Binding PopupShowForget}" />
              </StackPanel>
              <StackPanel IsVisible="{Binding PopupShowPitch}" Margin="24,0,0,0">
                <CheckBox Content="Draw pitch accent diagrams instead of numbers"
                          IsChecked="{Binding PopupPitchDiagram}" />
              </StackPanel>
              <CheckBox Content="Show which lists and decks the word is in"
                        IsChecked="{Binding PopupShowDeckMembership}" />
              <CheckBox Content="Show review buttons" IsChecked="{Binding PopupShowReview}" />
              <CheckBox Content="Use two grades (Pass/Fail) instead of four"
                        IsChecked="{Binding PopupUseTwoGrades}" />
              <CheckBox Content="Move the action buttons below the entry"
                        IsChecked="{Binding PopupMoveActionsBottom}" />
              <CheckBox Content="Open the word on jiten.moe when its headword is clicked"
                        IsChecked="{Binding PopupHeadwordLink}" />
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Text="STATE ROTATION" Classes="section-header" />
              <TextBlock Text="Rotates a word through its Master, Blacklist and Suspended states with a single pair of keys."
                         FontSize="12" Foreground="#71717a" TextWrapping="Wrap" />
              <CheckBox Content="Rotate states" IsChecked="{Binding RotateStatesEnabled}" />
              <StackPanel IsVisible="{Binding RotateStatesEnabled}" Margin="24,0,0,0" Spacing="4">
                <CheckBox Content="Show rotate actions" IsChecked="{Binding PopupShowRotateActions}" />
                <CheckBox Content="Rotate cycle" IsChecked="{Binding RotateCycle}" />
                <TextBlock Text="Stays among the states instead of passing through a cleared step"
                           FontSize="11" Foreground="#71717a" TextWrapping="Wrap" Margin="28,0,0,0" />
                <TextBlock Text="States in the cycle" Foreground="#a1a1aa" FontSize="13"
                           FontWeight="Medium" Margin="0,4,0,0" />
                <WrapPanel Orientation="Horizontal">
                  <CheckBox Content="Master" IsChecked="{Binding RotateCycleNeverForget}" Margin="0,0,16,0" />
                  <CheckBox Content="Blacklist" IsChecked="{Binding RotateCycleBlacklist}" Margin="0,0,16,0" />
                  <CheckBox Content="Suspended" IsChecked="{Binding RotateCycleSuspended}" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- ═══════ KEYBINDS TAB ═══════ -->
          <StackPanel IsVisible="{Binding SelectedTabIndex, Converter={StaticResource ParseEquals}, ConverterParameter=5}"
                      Spacing="16">
            <TextBlock Text="Keybinds" FontSize="20" FontWeight="Bold" Foreground="#ffffff" />
            <TextBlock Text="Keyboard shortcuts for popup actions (only active when popup is visible)"
                       FontSize="12" Foreground="#71717a" TextWrapping="Wrap" />
            <TextBlock Text="Use mpv key names: 1, 2, a, Ctrl+s, Shift+r, etc."
                       FontSize="11" Foreground="#52525b" TextWrapping="Wrap" />

            <Border Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1"
                    CornerRadius="8" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="REVIEW" Classes="section-header" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                  <TextBlock Text="Again / Fail" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Column="1" Text="{Binding KeybindReviewAgain}"
                           PlaceholderText="e.g. 1" MaxWidth="200" HorizontalAlignment="Left" />

                  <TextBlock Grid.Row="1" Text="Hard" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KeybindReviewHard}"
                           PlaceholderText="e.g. 2" MaxWidth="200" HorizontalAlignment="Left" />

                  <TextBlock Grid.Row="2" Text="Good / Pass" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding KeybindReviewGood}"
                           PlaceholderText="e.g. 3" MaxWidth="200" HorizontalAlignment="Left" />

                  <TextBlock Grid.Row="3" Text="Easy" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KeybindReviewEasy}"
                           PlaceholderText="e.g. 4" MaxWidth="200" HorizontalAlignment="Left" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1"
                    CornerRadius="8" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="STATE ACTIONS" Classes="section-header" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                  <TextBlock Text="Never Forget" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Column="1" Text="{Binding KeybindNeverForget}"
                           PlaceholderText="e.g. m" MaxWidth="200" HorizontalAlignment="Left" />

                  <TextBlock Grid.Row="1" Text="Blacklist" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KeybindBlacklist}"
                           PlaceholderText="e.g. b" MaxWidth="200" HorizontalAlignment="Left" />

                  <TextBlock Grid.Row="2" Text="Suspend" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding KeybindSuspend}"
                           PlaceholderText="e.g. s" MaxWidth="200" HorizontalAlignment="Left" />

                  <TextBlock Grid.Row="3" Text="Forget" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KeybindForget}"
                           PlaceholderText="e.g. f" MaxWidth="200" HorizontalAlignment="Left" />

                  <TextBlock Grid.Row="4" Text="Mine to list" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding KeybindMine}"
                           PlaceholderText="e.g. d" MaxWidth="200" HorizontalAlignment="Left" />

                  <TextBlock Grid.Row="5" Text="Rotate forward" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding KeybindRotateForward}"
                           PlaceholderText="unbound" MaxWidth="200" HorizontalAlignment="Left" />

                  <TextBlock Grid.Row="6" Text="Rotate backward" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding KeybindRotateBackward}"
                           PlaceholderText="unbound" MaxWidth="200" HorizontalAlignment="Left" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1"
                    CornerRadius="8" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="SUBTITLE NAVIGATION" Classes="section-header" />
                <TextBlock Text="Always active, unlike the popup keybinds above. A key already bound in input.conf keeps its own meaning."
                           FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                  <TextBlock Text="Previous subtitle" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Column="1" Text="{Binding KeybindPrevSub}"
                           PlaceholderText="unbound" MaxWidth="200" HorizontalAlignment="Left" />

                  <TextBlock Grid.Row="1" Text="Next subtitle" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KeybindNextSub}"
                           PlaceholderText="unbound" MaxWidth="200" HorizontalAlignment="Left" />

                  <TextBlock Grid.Row="2" Text="Loop subtitle" VerticalAlignment="Center" Foreground="#a1a1aa" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding KeybindLoopSub}"
                           PlaceholderText="unbound" MaxWidth="200" HorizontalAlignment="Left" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ═══════ ADVANCED TAB ═══════ -->
          <StackPanel IsVisible="{Binding SelectedTabIndex, Converter={StaticResource ParseEquals}, ConverterParameter=6}"
                      Spacing="16">
            <TextBlock Text="Advanced" FontSize="20" FontWeight="Bold" Foreground="#ffffff" />

            <StackPanel Spacing="8">
              <TextBlock Text="STARTUP" Classes="section-header" />
              <CheckBox Content="Start automatically when a file is opened"
                        IsChecked="{Binding PluginAutostart}" />
              <TextBlock Text="Turn this off to keep subtitles untouched until you ask for them. The key below starts JitenMPV either way, and also restarts it if it stops."
                         FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Start key" Classes="field-label" />
                <TextBox Text="{Binding PluginStartKey}" Width="120" PlaceholderText="F10" />
              </StackPanel>
              <TextBlock Text="An mpv key name, such as F10, Ctrl+j or ALT+s. Takes effect when mpv restarts."
                         FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="4">
              <TextBlock Text="Parse cache size" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
              <NumericUpDown Value="{Binding CacheSize}" Minimum="500" Maximum="10000" Increment="500" />
              <TextBlock Text="Number of parsed subtitles kept in memory (requires restart)"
                         FontSize="11" Foreground="#71717a" />
            </StackPanel>

            <Border Classes="divider" />

            <CheckBox Content="Enable subtitle pre-parsing" IsChecked="{Binding PreparseEnabled}" />

            <Border Classes="divider" />

            <StackPanel Spacing="4">
              <TextBlock Text="MOUSE INTERACTION" Classes="section-header" />
              <TextBlock Text="Interaction zone (%)" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" Margin="0,4,0,0" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Slider Value="{Binding MouseZonePercent}" Minimum="30" Maximum="100" Width="250"
                        TickFrequency="5" IsSnapToTickEnabled="True" />
                <TextBlock Text="{Binding MouseZonePercent, StringFormat='Bottom {0}%'}"
                           VerticalAlignment="Center" Foreground="#ffffff" />
              </StackPanel>
              <TextBlock Text="Mouse events are only tracked in this percentage of the screen from the bottom"
                         FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />

              <CheckBox Content="Show settings button on mouse move" IsChecked="{Binding SettingsButtonEnabled}"
                        Margin="0,8,0,0" />
              <TextBlock Text="Fades a clickable button into the top-right corner of the video while the mouse moves (same as Ctrl+J)"
                         FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />

              <CheckBox Content="Show previous/next subtitle buttons" IsChecked="{Binding SubtitleNavButtonsEnabled}"
                        Margin="0,8,0,0" />
              <TextBlock Text="Buttons in the bottom corners that jump to the previous or next subtitle line"
                         FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="8">
              <TextBlock Text="DIAGNOSTICS" Classes="section-header" />
              <CheckBox Content="Show status overlay messages" IsChecked="{Binding StatusOverlayEnabled}" />
              <CheckBox Content="Enable debug logging" IsChecked="{Binding DebugLogging}" />
              <CheckBox Content="Show word hitboxes" IsChecked="{Binding DebugShowHitboxes}" />
              <TextBlock Text="Draws the clickable area of every word over the subtitle, each in its own colour. The filled box is what the hover test accepts, the inner outline is the word itself, and the centre bar is what decides the winner where two boxes overlap."
                         FontSize="11" Foreground="#71717a" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="divider" />

            <StackPanel Spacing="4">
              <TextBlock Text="Config file location" Foreground="#a1a1aa" FontSize="13" FontWeight="Medium" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding ConfigFilePath}" VerticalAlignment="Center"
                           FontSize="12" Foreground="#71717a" TextWrapping="Wrap" IsHitTestVisible="False" />
                <Button Grid.Column="1" Content="Open folder" Classes="secondary"
                        Command="{Binding OpenConfigFolderCommand}" />
              </Grid>
            </StackPanel>
          </StackPanel>

        </Panel>
      </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="#09090b" Padding="16,12" BorderBrush="#27272a" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <Button Content="Reset Section" Classes="secondary"
                Command="{Binding ResetSectionCommand}" />
        <TextBlock Grid.Column="1" Text="{Binding VersionLabel}" Margin="12,0,0,0"
                   VerticalAlignment="Center" FontSize="11" Foreground="#52525b" />
        <Button Grid.Column="3" Content="Close" IsCancel="True"
                Classes="secondary"
                Click="OnClose" Margin="0,0,8,0" />
        <Button Grid.Column="4" Content="Save"
                Click="OnSave" Classes="accent" />
      </Grid>
    </Border>
  </Grid>
</Window>
