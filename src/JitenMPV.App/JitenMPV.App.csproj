<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- Release builds override this from the git tag (-p:Version=1.2.3). -->
        <Version>0.1.0</Version>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <!-- The Lua script spawns this executable from a fixed path, so a publish has to yield exactly
         one file: PublishSingleFile alone leaves SkiaSharp, HarfBuzz and ANGLE as loose native DLLs
         that the OS loader needs on disk, and an update that replaced only the exe would then mix
         binaries. Scoped to RID-specific builds so a plain `dotnet build` still produces PDBs. -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <!-- DebugType only suppresses our own symbols. SkiaSharp and HarfBuzz ship 100 MB of PDBs as
         native runtime assets, which no property excludes, and they would otherwise more than
         triple the release download. -->
    <Target Name="RemoveNativeSymbolsFromPublish" AfterTargets="Publish"
            Condition="'$(RuntimeIdentifier)' != ''">
        <ItemGroup>
            <_PublishedSymbolFiles Include="$(PublishDir)**\*.pdb" />
        </ItemGroup>
        <Delete Files="@(_PublishedSymbolFiles)" />
    </Target>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\JitenMPV.Core\JitenMPV.Core.csproj" />
    </ItemGroup>
</Project>
